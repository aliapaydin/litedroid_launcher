<?xml version="1.0" encoding="utf-8"?>
<!-- Kumanda kısayolu: başka bir uygulama açıkken Geri'ye iki kez basınca LiteDroid menüsü açılır.
     Tuş olaylarını ve hangi uygulamanın önde olduğunu görür (uygulama kilidi, mola hatırlatıcısı).
     Ekran içeriğini okumaz; yalnızca telefondan gönderilen yazı için odaklı yazı kutusunu bulur. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="100"
    android:description="@string/remote_key_description" />
